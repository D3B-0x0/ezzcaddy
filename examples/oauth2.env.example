# =============================================================================
# oauth2-proxy settings — COPY to oauth2.env (chmod 600). Never commit.
# REQUIRED only in SSO mode (Mode 2/3). Ignored otherwise.
# ORDER: start pocket-id first, create OIDC client there, THEN fill this file.
# Docs: https://oauth2-proxy.github.io/oauth2-proxy/configuration/overview/
# =============================================================================

# --- Identity provider — YOUR CHOICE: must match YOUR pocket-id URL + client.
# --- ISSUER must be the public pocket-id URL (what users see in browser).
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_PROVIDER_DISPLAY_NAME=Pocket-ID
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.com
OAUTH2_PROXY_CLIENT_ID=paste-client-id-from-pocket-id-here
OAUTH2_PROXY_CLIENT_SECRET=paste-client-secret-here
# --- File-secret alternative — YOUR CHOICE (stronger): uncomment + create file,
# --- then DELETE the plaintext line above. Never both.
# OAUTH2_PROXY_CLIENT_SECRET_FILE=/run/secrets/oauth2_client_secret
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_EMAIL_DOMAINS=*
# ^^^ YOUR CHOICE: `*` = any pocket-id user. Restrict to allow only that domain.

# --- Cookies — YOUR CHOICE: must match YOUR parent domain.
OAUTH2_PROXY_COOKIE_DOMAINS=.example.com
OAUTH2_PROXY_COOKIE_EXPIRE=12h
# ^^^ YOUR CHOICE: session lifetime. 12h dashboards, 15m vaults.
OAUTH2_PROXY_COOKIE_REFRESH=0
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
OAUTH2_PROXY_COOKIE_SECRET=paste-openssl-rand-base64-32-here
# ^^^ GENERATE: openssl rand -base64 32 | head -c 32
# --- File-secret alternative:
# OAUTH2_PROXY_COOKIE_SECRET_FILE=/run/secrets/oauth2_cookie_secret

# --- Redirect — YOUR CHOICE: must be YOUR sso public URL + /oauth2/callback.
# --- This EXACT URL must be allow-listed in the pocket-id OIDC client.
OAUTH2_PROXY_REDIRECT_URL=https://sso.example.com/oauth2/callback
OAUTH2_PROXY_WHITELIST_DOMAINS=.example.com
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
# ^^^ YOUR CHOICE: true = straight to pocket-id. Keep true unless multi-provider.

# --- Reverse-proxy trust — YOUR CHOICE: keep as-is for bridge mode.
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
OAUTH2_PROXY_HTTP_ADDRESS=:4180
OAUTH2_PROXY_SET_XAUTHREQUEST=true
# ^^^ REQUIRED for Caddy forward_auth. Keep true.
