# =============================================================================
# pocket-id settings — COPY to pocketid.env (chmod 600). Never commit.
# REQUIRED only in SSO mode (Mode 2/3). Ignored otherwise.
# FIRST RUN: start pocket-id, open APP_URL, create admin + OIDC client for
# oauth2-proxy (redirect URL = OAUTH2_PROXY_REDIRECT_URL in oauth2.env).
# Docs: https://pocket-id.org/docs
# =============================================================================

# --- Public URL — YOUR CHOICE: must be YOUR auth subdomain (what users open).
# --- Changing this later breaks OIDC issuer — pick once, keep forever.
APP_URL=https://auth.example.com

# --- Encryption key — GENERATE: openssl rand -hex 32
# --- LOSE THIS = all sessions/clients invalid. Back up with pocketid-data volume.
ENCRYPTION_KEY=paste-openssl-rand-hex-32-here

# --- GeoIP inside pocket-id — YOUR CHOICE: shows login locations. Needs free
# --- MaxMind license (same account as geoipupdate). Leave empty to skip.
MAXMIND_LICENSE_KEY=

# --- Mail (optional) — YOUR CHOICE: for invites/password resets. Leave empty
# --- for passkey-only local use. Any SMTP works.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
